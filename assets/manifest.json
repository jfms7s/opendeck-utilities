{
	"Name": "Utilities",
	"Author": "jfms7s",
	"Version": "0.7.0",
	"Category": "Utilities",
	"Icon": "icons/icon",
	"CategoryIcon": "icons/category",
	"OS": [{ "Platform": "linux" }, { "Platform": "mac" }],
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "opendeck-utilities-x86_64-unknown-linux-gnu",
		"aarch64-apple-darwin": "opendeck-utilities-aarch64-apple-darwin"
	},
	"CodePathLin": "opendeck-utilities-x86_64-unknown-linux-gnu",
	"CodePathMac": "opendeck-utilities-aarch64-apple-darwin",
	"Actions": [
		{
			"UUID": "com.jfms7s.utilities.audio",
			"Name": "Audio",
			"Icon": "icons/audio",
			"Tooltip": "Volume, mute and device switching for an output, input or app, with a live level on the key or touch strip",
			"Controllers": ["Encoder", "Keypad"],
			"PropertyInspectorPath": "propertyInspector/audio.html",
			"States": [{ "Image": "icons/audioKey" }],
			"Encoder": { "layout": "layouts/level.json" }
		},
		{
			"UUID": "com.jfms7s.utilities.brightness",
			"Name": "Device Brightness",
			"Icon": "icons/brightness",
			"Tooltip": "Step or set the Stream Deck's brightness",
			"Controllers": ["Encoder", "Keypad"],
			"PropertyInspectorPath": "propertyInspector/brightness.html",
			"States": [{ "Image": "icons/brightnessKey" }],
			"Encoder": { "layout": "layouts/level.json" }
		},
		{
			"UUID": "com.jfms7s.utilities.dnd",
			"Name": "Do Not Disturb",
			"Icon": "icons/dnd",
			"Tooltip": "Silence desktop notifications, and see when they are silenced (Linux only)",
			"Controllers": ["Keypad"],
			"States": [{ "Image": "icons/dndKey" }]
		},
		{
			"UUID": "com.jfms7s.utilities.media",
			"Name": "Media",
			"Icon": "icons/media",
			"Tooltip": "Now playing on the touch strip: rotate to seek, press to play or pause, tap for the next track (Linux only)",
			"Controllers": ["Encoder"],
			"States": [{ "Image": "icons/media" }],
			"Encoder": { "layout": "layouts/now-playing.json" }
		},
		{
			"UUID": "com.jfms7s.utilities.profile",
			"Name": "Switch Profile",
			"Icon": "icons/profile",
			"Tooltip": "Switch to a profile, or pick one with the dial and press to switch",
			"Controllers": ["Encoder", "Keypad"],
			"PropertyInspectorPath": "propertyInspector/profile.html",
			"States": [{ "Image": "icons/profileKey" }],
			"Encoder": { "layout": "layouts/profile.json" }
		}
	]
}
